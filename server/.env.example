NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@<cluster>/<database>?retryWrites=true&w=majority
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
CLIENT_ORIGIN=http://localhost:3000
DEMO_MODE=true
DEMO_EMAIL=demo@ricoiz.local
DEMO_PASSWORD=change-this-demo-password

# Google Business Profile OAuth (requires Google API project approval)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/api/integrations/google-business-profile/callback
GOOGLE_TOKEN_ENCRYPTION_KEY=
