NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb+srv://<db-user>:<db-password>@<cluster-host>/<database>?retryWrites=true&w=majority
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
JWT_EXPIRES_IN=7d

CLIENT_ORIGIN=http://localhost:3000

DEMO_MODE=true
DEMO_EMAIL=demo@ricoiz.local
DEMO_PASSWORD=YourStrongDemoPassword123!

# Dedicated shared secret for n8n -> Ricoiz API (minimum 32 random characters)
RICOIZ_N8N_API_KEY=replace-with-a-random-secret-of-at-least-32-characters
