"use node";

import { v } from "convex/values";
import { action, internalAction } from "./_generated/server";
import { api, internal } from "./_generated/api";
import { Id } from "./_generated/dataModel";

/**
 * Handle Stripe webhook events. Called by http.ts.
 * Note: Signature verification is basic here — in production use `stripe.webhooks.constructEvent`.
 */
export const handleWebhook = action({
  args: {
    signature: v.string(),
    body: v.string(),
  },
  handler: async (ctx, { signature, body }): Promise<any> => {
    // TODO: Verify signature with stripe SDK — omitted for skeleton
    // const event = stripe.webhooks.constructEvent(body, signature, process.env.STRIPE_WEBHOOK_SECRET!)

    const event = JSON.parse(body);
    const type = event.type;

    switch (type) {
      case "checkout.session.completed":
        return await handleCheckoutCompleted(ctx, event.data.object);
      case "customer.subscription.updated":
        return await handleSubscriptionUpdated(ctx, event.data.object);
      case "customer.subscription.deleted":
        return await handleSubscriptionDeleted(ctx, event.data.object);
      case "invoice.payment_failed":
        return await handlePaymentFailed(ctx, event.data.object);
      case "invoice.payment_succeeded":
        return await handlePaymentSucceeded(ctx, event.data.object);
      default:
        return { ok: true, ignored: true, type };
    }
  },
});

async function handleCheckoutCompleted(ctx: any, session: any): Promise<any> {
  const metadata = session.metadata || {};
  const isFoundingClient = metadata.founding5 === "true";
  const referralCode = metadata.referralCode;

  // Session should have customer_details filled in by onboarding form
  // For MVP: we defer client creation until onboarding form completed
  // This webhook just records the payment + emits notification
  return {
    ok: true,
    action: "checkout_completed",
    stripeCustomerId: session.customer,
    stripeSubscriptionId: session.subscription,
    isFoundingClient,
    referralCode,
  };
}

async function handleSubscriptionUpdated(ctx: any, subscription: any): Promise<any> {
  await ctx.runMutation(internal.reviewClients.updateSubscriptionStatus, {
    stripeCustomerId: subscription.customer,
    status: subscription.status,
    currentPeriodEnd: subscription.current_period_end * 1000,
  });
  return { ok: true, action: "subscription_updated" };
}

async function handleSubscriptionDeleted(ctx: any, subscription: any): Promise<any> {
  await ctx.runMutation(internal.reviewClients.deactivate, {
    stripeCustomerId: subscription.customer,
  });
  return { ok: true, action: "subscription_deleted" };
}

async function handlePaymentFailed(ctx: any, invoice: any): Promise<any> {
  await ctx.runMutation(internal.reviewClients.updateSubscriptionStatus, {
    stripeCustomerId: invoice.customer,
    status: "past_due",
  });
  return { ok: true, action: "payment_failed" };
}

async function handlePaymentSucceeded(ctx: any, invoice: any): Promise<any> {
  await ctx.runMutation(internal.reviewClients.updateSubscriptionStatus, {
    stripeCustomerId: invoice.customer,
    status: "active",
  });
  return { ok: true, action: "payment_succeeded" };
}
