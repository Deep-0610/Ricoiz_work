# Convex environment variables — Review Engine
# Deployment: YOUR_CONVEX_DEPLOYMENT (DEV)
# HTTP endpoints: https://YOUR_CONVEX_DEPLOYMENT

# Auth token that n8n workflows must send in Authorization: Bearer header
CONVEX_AUTH_TOKEN=vlt_xxxxx

# Public click tracker domain (for review link generation in customer SMS)
# Phase 1: use YOUR_CONVEX_DEPLOYMENT.convex.site directly
# Phase 2: point custom domain like https://go.<your-domain> to Convex
CLICK_TRACKER_DOMAIN=https://YOUR_CONVEX_DEPLOYMENT

# Stripe webhook secret (Phase 2 only)
STRIPE_WEBHOOK_SECRET=whsec_xxxxx

# Stripe secret key (Phase 2 — for creating referral promo codes)
STRIPE_SECRET_KEY=sk_live_xxxxx
